# Schwab API — get these from developer.schwab.com
SCHWAB_API_KEY=your_api_key_here
SCHWAB_API_SECRET=your_api_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_TOKEN_PATH=tokens/schwab_token.json
SCHWAB_ACCOUNT_HASH=your_account_hash_here

# SEC EDGAR — required by SEC (use your real name + email)
EDGAR_USER_AGENT=YourName your@email.com

# Database — SQLite by default, swap to postgres for production
# DATABASE_URL=postgresql://user:pass@localhost/new_world_order

# Logging
LOG_LEVEL=INFO
