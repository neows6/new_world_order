# ============================================================================
#  New World Order (NWO) — environment template
#  Copy this file to ".env" and fill in your own values. NEVER commit .env.
#  The installer (install.ps1) copies this for you automatically.
# ============================================================================

# --- Schwab API (REQUIRED for live/paper price data) -----------------------
# Create a developer app at https://developer.schwab.com
SCHWAB_API_KEY=your_api_key_here
SCHWAB_API_SECRET=your_api_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_TOKEN_PATH=tokens/schwab_token.json
# Get this from your Schwab account after the first OAuth (python get_token.py)
SCHWAB_ACCOUNT_HASH=your_account_hash_here

# --- SEC EDGAR (REQUIRED — SEC rejects requests without a real UA) ----------
# Use your real name + email, e.g. "Chris Smith chris@example.com"
EDGAR_USER_AGENT=YourName your@email.com

# --- AI narrators -----------------------------------------------------------
# Claude Haiku: sentinel, data validator, morning-brief fallback
ANTHROPIC_API_KEY=your_anthropic_key_here
# Gemini Flash: morning-brief primary narrator
GOOGLE_API_KEY=your_google_key_here

# --- Telegram alerts (OPTIONAL — leave blank to disable) --------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TipRanks scraping (OPTIONAL — leave blank to disable) ------------------
TIPRANKS_EMAIL=
TIPRANKS_PASSWORD=

# --- Database — SQLite by default; swap to postgres for production ----------
# DATABASE_URL=postgresql://user:pass@localhost/new_world_order

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# BRIEF_GENERATE_TIME=07:00
